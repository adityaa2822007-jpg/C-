#include <iostream>
using namespace std;
struct student
{
    string name;
    int age;
    int rollNo;
    int marks;
};

int main()
{
    struct student addy;
    cout<<"Enter age, rollNo and marks : "<<endl;
    cin>>addy.age>>addy.rollNo>>addy.marks;
    cout<<"Enter name : "<<endl;
    cin>>addy.name;

    cout<<"Name : "<<addy.name<<endl;
    cout<<"Age : " <<addy.age<<endl;
    cout<<"RollNo : "<<addy.rollNo<<endl;
    cout<<"Marks : "<<addy.marks<<endl;

}
