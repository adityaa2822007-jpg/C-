#include<iostream>
using namespace std;
int largest(int a, int b, int c)
{
if(a>b && a>c)
{
    return a;
}
else if(b>c && b>a)
{
    return b;
}
else
{
    return c;
}
}

int main()
{
    int num1, num2, num3;
    
    cout<<"Enter any three No. : ";
    cin>>num1>>num2>>num3;

    cout<<"the largest No. is : "<<largest(num1, num2, num3);
    return 0;
}
